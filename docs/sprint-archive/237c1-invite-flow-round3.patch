+++ b/apps/web/lib/__tests__/manager-invite-email.test.ts
@@ -0,0 +1,49 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+const gate = vi.hoisted(() => ({ mode: vi.fn(), list: vi.fn(), allowed: vi.fn() }));
+vi.mock("@/lib/notifications-switch", () => ({ notificationMode: gate.mode,
+  notificationAllowlist: gate.list, isNotificationRecipientAllowed: gate.allowed }));
+import { buildManagerInviteEmail, canSendBrandedManagerInvite, sendManagerInviteEmail } from "../invite-email";
+
+afterEach(() => { vi.unstubAllEnvs(); vi.unstubAllGlobals(); vi.clearAllMocks(); });
+describe("manager invite email", () => {
+  it("uses exact subject, body, button and plain text", () => {
+    const email = buildManagerInviteEmail({ inviterName: "Ace", homeNames: ["Oak Home"], inviteUrl: "https://test/link" });
+    expect(email.subject).toBe("Ace added you to Domus");
+    expect(email.html).toContain("Ace wants you to manage Oak Home on Domus.");
+    expect(email.html).toContain("Set up your account");
+    expect(email.html).toContain("If you were not expecting this, you can ignore it.");
+    expect(email.text).toContain("If you were not expecting this, you can ignore it.");
+    expect(buildManagerInviteEmail({ inviterName: "Ace", homeNames: ["A", "B"], inviteUrl: "https://test/link" }).text)
+      .toContain("manage 2 homes on Domus.");
+  });
+  it("fails closed for off, unknown mode, lookup error and non-allowlisted test recipients", () => {
+    gate.list.mockReturnValue(["allowed@example.com"]);
+    gate.allowed.mockImplementation((_mode: string, email: string) => email === "allowed@example.com");
+    gate.mode.mockReturnValue("test");
+    expect(canSendBrandedManagerInvite("allowed@example.com")).toBe(true);
+    expect(canSendBrandedManagerInvite("other@example.com")).toBe(false);
+    gate.mode.mockReturnValue("off");
+    expect(canSendBrandedManagerInvite("allowed@example.com")).toBe(false);
+    gate.mode.mockReturnValue("on");
+    gate.allowed.mockReturnValue(true);
+    expect(canSendBrandedManagerInvite("other@example.com")).toBe(true);
+    gate.mode.mockReturnValue("unknown");
+    expect(canSendBrandedManagerInvite("allowed@example.com")).toBe(false);
+    gate.mode.mockImplementation(() => { throw new Error("gate failed"); });
+    expect(canSendBrandedManagerInvite("allowed@example.com")).toBe(false);
+  });
+  it("sends only when the gate allows the recipient", async () => {
+    vi.stubEnv("RESEND_API_KEY", "test-key");
+    vi.stubEnv("RESEND_FROM_EMAIL", "test@example.com");
+    const fetchMock = vi.fn().mockResolvedValue({ ok: true });
+    vi.stubGlobal("fetch", fetchMock);
+    gate.mode.mockReturnValue("test");
+    gate.list.mockReturnValue(["allowed@example.com"]);
+    gate.allowed.mockImplementation((_mode: string, email: string) => email === "allowed@example.com");
+    const payload = { email: "blocked@example.com", inviterName: "Ace", homeNames: ["Oak"], inviteUrl: "https://test/link" };
+    expect(await sendManagerInviteEmail(payload)).toBe(false);
+    expect(fetchMock).not.toHaveBeenCalled();
+    expect(await sendManagerInviteEmail({ ...payload, email: "allowed@example.com" })).toBe(true);
+    expect(fetchMock).toHaveBeenCalledOnce();
+  });
+});
